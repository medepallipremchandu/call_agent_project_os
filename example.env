# ── AI Voice Call Agent Platform (app/) ────────────────────────────────────────
# This DATABASE_URL is for running `uvicorn app.main:app` directly on the host.
# Running via `docker compose up` instead? That service already overrides this
# (see docker-compose.yml api.environment) to use the "postgres" hostname —
# you don't need to change this line for that case.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talent_os_call_agent

# Public URL Twilio calls back to (must include the scheme). For local dev
# without a tunnel, this is fine for the API/UI, but Twilio itself cannot
# reach 127.0.0.1 — use a tunnel URL (e.g. cloudflared/ngrok) here once you're
# ready to place a real call.
BASE_URL=https://mainland-expense-pre-parallel.trycloudflare.com

# Fernet key encrypting every tenant's stored provider credentials at rest.
# Do not regenerate this without re-entering every organization's credentials
# through the onboarding UI — losing it makes existing stored credentials
# unrecoverable.
CREDENTIAL_ENCRYPTION_KEY=EDYnpymBC-NbkwZHx4d5hEnsTSwXJM5MXa2ejkpQEiU=

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
